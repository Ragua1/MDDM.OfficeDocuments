<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>4.0.0</Version>
        <Title>OfficeDocuments.Excel.Advanced</Title>
        <Description>Optional advanced layer for OfficeDocuments.Excel: structured tables, named ranges, workbook/worksheet protection, and image embedding. Adds these as extension methods over the minimal core so a consumer who only needs the core does not pay for them.</Description>
        <PackageTags>Office;Excel;C#</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DocumentFormat.OpenXml" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OfficeDocuments.Excel\OfficeDocuments.Excel.csproj" />
    </ItemGroup>

    <!-- The unit tier tests WorkbookElementOrderer (a pure-logic collaborator) directly. -->
    <ItemGroup>
        <InternalsVisibleTo Include="OfficeDocuments.Excel.UnitTests" />
    </ItemGroup>

    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\">
            <Link>LICENSE.md</Link>
        </None>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
