<Project>

  <!-- Compilation policy — centralized for all projects -->
  <PropertyGroup>
    <LangVersion>default</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Shared NuGet metadata — project-specific fields stay in individual .csproj files -->
  <PropertyGroup>
    <Authors>Martin Domanský</Authors>
    <Company>MDDM</Company>
    <Copyright>MDDM</Copyright>
    <PackageProjectUrl>https://github.com/Ragua1/MDDM.OfficeDocuments</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ragua1/MDDM.OfficeDocuments</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PublicSign>false</PublicSign>
  </PropertyGroup>

</Project>
