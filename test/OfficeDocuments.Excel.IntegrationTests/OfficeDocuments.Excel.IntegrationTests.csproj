<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Integration tier. Entry rule: exercises two or more collaborating types through the PUBLIC
        API, over a MemoryStream, asserting on the object model and on the specific DOM nodes the
        feature is supposed to produce.

        A test that asks "is the finished file a valid document?" belongs in the verification tier.
        See .doc/tasks/core/excel/EXCEL-011-test-suite-restructuring.md.
    -->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.analyzers">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Drawing" />
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\OfficeDocuments.Excel\OfficeDocuments.Excel.csproj" />
        <ProjectReference Include="..\OfficeDocuments.Excel.TestKit\OfficeDocuments.Excel.TestKit.csproj" />
    </ItemGroup>

</Project>
