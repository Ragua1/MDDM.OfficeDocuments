<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Unit tier. Entry rule: a test here must be writable WITHOUT constructing a
        SpreadsheetDocument, opening a stream, or touching the file system.

        This project deliberately does NOT reference OfficeDocuments.Excel.TestKit — the file
        workspace and the schema validator belong to the integration and verification tiers, and
        keeping them out of reach is what stops this project from quietly drifting into one.
        See .doc/tasks/core/excel/EXCEL-011-test-suite-restructuring.md.
    -->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.analyzers">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\OfficeDocuments.Excel\OfficeDocuments.Excel.csproj" />
        <!-- WorkbookElementOrderer moved to the advanced layer (EXCEL-010 Tier 2); it is still a
             pure-logic unit worth testing directly, so the unit tier references Advanced too. -->
        <ProjectReference Include="..\..\src\OfficeDocuments.Excel.Advanced\OfficeDocuments.Excel.Advanced.csproj" />
    </ItemGroup>

</Project>
